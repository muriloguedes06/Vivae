generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ORGANIZER
  GATE_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum EventCategory {
  CONCERT
  MOVIE
  FESTIVAL
  CONFERENCE
  WORKSHOP
  THEATER
  SPORTS
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum TicketingMode {
  GENERAL_ADMISSION
  RESERVED_SEATING
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum ValidationStatus {
  VALID
  INVALID
  ALREADY_USED
  WRONG_EVENT
  CANCELLED_TICKET
}

model User {
  id       String     @id @default(cuid())
  username String     @unique
  email    String     @unique
  password String
  lastname String?
  role     UserRole   @default(CUSTOMER)
  status   UserStatus @default(ACTIVE)

  organizedEvents Event[]            @relation("EventOrganizer")
  orders          Order[]
  tickets         Ticket[]           @relation("TicketOwner")
  validations     TicketValidation[] @relation("ValidationOperator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
}

/// Evento local criado a partir de uma referência externa ou manualmente.
/// A Ticketmaster não é a fonte de preço, capacidade ou estoque da plataforma.
model Event {
  id             String        @id @default(cuid())
  organizerId    String
  externalSource String?
  externalId     String?
  title          String
  description    String        @db.Text
  category       EventCategory @default(OTHER)
  status         EventStatus   @default(DRAFT)
  ticketingMode  TicketingMode @default(GENERAL_ADMISSION)
  coverUrl       String?

  venueName String
  address   String
  city      String
  state     String
  startsAt  DateTime
  endsAt    DateTime?

  organizer   User               @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes TicketType[]
  seats       Seat[]
  orders      Order[]
  tickets     Ticket[]
  validations TicketValidation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizerId, externalSource, externalId])
  @@index([organizerId, status])
  @@index([status, startsAt])
  @@index([category, status])
  @@index([city, state])
}

/// Categoria vendida por quantidade: Pista, VIP, Camarote etc.
/// Preço e capacidade são definidos localmente pelo organizador.
model TicketType {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  capacity    Int
  reserved    Int     @default(0)
  sold        Int     @default(0)
  active      Boolean @default(true)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@index([eventId, active])
}

/// Assento local de um evento do tipo cinema/teatro.
model Seat {
  id      String  @id @default(cuid())
  eventId String
  row     String
  number  Int
  label   String
  blocked Boolean @default(false)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  ticket     Ticket?

  createdAt DateTime @default(now())

  @@unique([eventId, row, number])
  @@unique([eventId, label])
  @@index([eventId, blocked])
}

/// Reserva temporária e resultado geral da compra.
model Order {
  id        String      @id @default(cuid())
  userId    String
  eventId   String
  code      String      @unique
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(12, 2)
  expiresAt DateTime?
  paidAt    DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  event    Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([eventId, status])
  @@index([status, expiresAt])
}

/// Snapshot da quantidade e do preço consultado no backend durante a reserva.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  seatId       String? @unique
  description  String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(12, 2)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seat       Seat?      @relation(fields: [seatId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([ticketTypeId])
}

/// Tentativa de pagamento exclusivamente simulada.
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  failureReason String?
  processedAt   DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
}

/// Ingresso emitido somente após a aprovação do pagamento.
model Ticket {
  id           String       @id @default(cuid())
  orderId      String
  orderItemId  String
  ownerId      String
  eventId      String
  ticketTypeId String
  seatId       String?      @unique
  code         String       @unique
  qrToken      String       @unique
  shareToken   String       @unique
  status       TicketStatus @default(ACTIVE)
  holderName   String
  issuedAt     DateTime     @default(now())
  usedAt       DateTime?
  cancelledAt  DateTime?

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem   OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  owner       User               @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType  TicketType         @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seat        Seat?              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  validations TicketValidation[]

  @@index([ownerId, status])
  @@index([eventId, status])
  @@index([orderId])
}

/// Auditoria das tentativas realizadas pela portaria.
model TicketValidation {
  id          String           @id @default(cuid())
  eventId     String
  ticketId    String?
  operatorId  String?
  scannedCode String
  status      ValidationStatus
  reason      String?
  scannedAt   DateTime         @default(now())

  event    Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  operator User?   @relation("ValidationOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([operatorId, scannedAt])
}
